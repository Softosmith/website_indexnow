<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="indexnow_submit_wizard_form" model="ir.ui.view">
        <field name="name">website.indexnow.submit.wizard.form</field>
        <field name="model">website.indexnow.submit.wizard</field>
        <field name="arch" type="xml">
            <form string="Submit Website Pages to IndexNow">
                <group>
                    <field name="website_id" options="{'no_create': True}"/>
                    <field name="page_ids" widget="many2many_tags" domain="[('website_id', 'in', [False, website_id])]" options="{'no_create': True}"/>
                    <field name="include_translations"/>
                </group>
                <footer>
                    <button name="action_queue_urls" type="object" string="Queue URLs" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_indexnow_submit_wizard" model="ir.actions.act_window">
        <field name="name">Submit Website Pages</field>
        <field name="res_model">website.indexnow.submit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
