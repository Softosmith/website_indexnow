<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="website_indexnow.IndexNowDashboard">
        <div class="o_indexnow_dashboard h-100 overflow-auto bg-light">
            <div class="container-fluid p-3 p-lg-4">
                <header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="o_indexnow_title_icon d-inline-flex align-items-center justify-content-center rounded-3">
                                <img src="/website_indexnow/static/description/icon.png" alt=""/>
                            </span>
                            <div>
                                <h2 class="mb-0">IndexNow Dashboard</h2>
                                <p class="text-muted mb-0">A live overview of indexing health, submissions, and queued URLs.</p>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <select class="form-select o_indexnow_website_filter" t-on-change="onWebsiteFilter" aria-label="Filter by website">
                            <option value="">All websites</option>
                            <t t-foreach="state.data.website_options || state.data.websites" t-as="website" t-key="website.id">
                                <option t-att-value="website.id" t-att-selected="state.websiteId === website.id"><t t-esc="website.name"/></option>
                            </t>
                        </select>
                        <div class="btn-group" role="group" aria-label="Dashboard period">
                            <button t-foreach="[1, 7, 30]" t-as="days" t-key="days" type="button"
                                t-att-class="state.days === days ? 'btn btn-primary' : 'btn btn-outline-secondary'"
                                t-on-click="() => this.setPeriod(days)">
                                <t t-esc="days === 1 ? '24h' : days + 'd'"/>
                            </button>
                        </div>
                        <button class="btn btn-outline-secondary" t-on-click="loadData" t-att-disabled="state.loading">
                            <i t-att-class="state.loading ? 'fa fa-refresh fa-spin me-1' : 'fa fa-refresh me-1'"/>Refresh
                        </button>
                    </div>
                </header>

                <div t-if="state.loading and !state.data.websites.length" class="d-flex align-items-center justify-content-center py-5">
                    <i class="fa fa-spinner fa-spin fa-2x text-primary me-3"/><span class="fs-5">Loading dashboard…</span>
                </div>

                <t t-else="">
                    <section class="row g-3 mb-4" aria-label="IndexNow key performance indicators">
                        <div class="col-12 col-sm-6 col-xl">
                            <button class="card o_indexnow_kpi o_indexnow_kpi_primary border-0 shadow-sm w-100 text-start" t-on-click="() => this.openQueue([])">
                                <div class="card-body d-flex justify-content-between align-items-start">
                                    <div><span class="text-muted">Enabled websites</span><div class="display-6 fw-semibold mt-2"><t t-esc="state.data.kpis.enabled_websites"/><small class="fs-6 text-muted"> / <t t-esc="state.data.kpis.total_websites"/></small></div></div>
                                    <span class="o_indexnow_kpi_icon"><i class="fa fa-globe"/></span>
                                </div>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-xl">
                            <button class="card o_indexnow_kpi o_indexnow_kpi_success border-0 shadow-sm w-100 text-start" t-on-click="() => this.openHistory()">
                                <div class="card-body d-flex justify-content-between align-items-start"><div><span class="text-muted">URLs submitted</span><div class="display-6 fw-semibold mt-2"><t t-esc="state.data.kpis.submitted_urls"/></div><small class="text-muted">Last <t t-esc="state.days"/> day(s)</small></div><span class="o_indexnow_kpi_icon"><i class="fa fa-paper-plane"/></span></div>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-xl">
                            <button class="card o_indexnow_kpi o_indexnow_kpi_warning border-0 shadow-sm w-100 text-start" t-on-click="() => this.openQueue([['state', 'in', ['pending', 'processing']]])">
                                <div class="card-body d-flex justify-content-between align-items-start"><div><span class="text-muted">Pending queue</span><div class="display-6 fw-semibold mt-2"><t t-esc="state.data.kpis.pending_urls"/></div><small class="text-muted">Waiting to process</small></div><span class="o_indexnow_kpi_icon"><i class="fa fa-clock-o"/></span></div>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-xl">
                            <button class="card o_indexnow_kpi o_indexnow_kpi_danger border-0 shadow-sm w-100 text-start" t-on-click="() => this.openQueue([['state', '=', 'failed']])">
                                <div class="card-body d-flex justify-content-between align-items-start"><div><span class="text-muted">Failed URLs</span><div class="display-6 fw-semibold mt-2"><t t-esc="state.data.kpis.failed_urls"/></div><small class="text-muted">Needs attention</small></div><span class="o_indexnow_kpi_icon"><i class="fa fa-exclamation-triangle"/></span></div>
                            </button>
                        </div>
                        <div class="col-12 col-sm-6 col-xl">
                            <div class="card o_indexnow_kpi o_indexnow_kpi_info border-0 shadow-sm h-100"><div class="card-body d-flex justify-content-between align-items-start"><div><span class="text-muted">Success rate</span><div class="display-6 fw-semibold mt-2"><t t-esc="state.data.kpis.success_rate"/>%</div><small class="text-muted">Submitted URL outcomes</small></div><span class="o_indexnow_kpi_icon"><i class="fa fa-line-chart"/></span></div></div>
                        </div>
                    </section>

                    <section class="row g-3 mb-4">
                        <div class="col-12 col-xl-8">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-header bg-transparent border-0 d-flex align-items-center justify-content-between pt-3 px-3 px-lg-4">
                                    <div><h4 class="mb-1">Submission activity</h4><span class="text-muted">Successful and failed URLs by day</span></div>
                                    <div class="d-flex gap-3 small"><span><i class="fa fa-circle text-success me-1"/>Submitted</span><span><i class="fa fa-circle text-danger me-1"/>Failed</span></div>
                                </div>
                                <div class="card-body px-3 px-lg-4">
                                    <div t-att-class="state.days === 30 ? 'o_indexnow_chart o_indexnow_chart_30d' : 'o_indexnow_chart'" role="img" aria-label="Daily submitted and failed URL bar chart">
                                        <div t-foreach="state.data.activity" t-as="day" t-key="day.key" class="o_indexnow_chart_day" t-att-title="day.label + ': ' + day.submitted + ' submitted, ' + day.failed + ' failed'">
                                            <div class="o_indexnow_chart_bars">
                                                <span t-if="day.submitted" class="o_indexnow_bar bg-success" t-att-style="'height:' + this.barHeight(day.submitted) + '%'"/>
                                                <span t-if="day.failed" class="o_indexnow_bar bg-danger" t-att-style="'height:' + this.barHeight(day.failed) + '%'"/>
                                            </div>
                                            <small class="text-muted o_indexnow_chart_label"><t t-esc="day.label"/></small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-xl-4">
                            <div t-att-class="state.data.kpis.failed_urls ? 'card border-danger shadow-sm h-100' : 'card border-success shadow-sm h-100'">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-start justify-content-between mb-3">
                                        <div><h4>System health</h4><p class="text-muted">Current status across the selected websites.</p></div>
                                        <span t-att-class="state.data.kpis.failed_urls ? 'o_indexnow_health_icon bg-danger-subtle text-danger' : 'o_indexnow_health_icon bg-success-subtle text-success'"><i t-att-class="state.data.kpis.failed_urls ? 'fa fa-exclamation' : 'fa fa-check'"/></span>
                                    </div>
                                    <div t-if="state.data.kpis.failed_urls" class="alert alert-danger mb-3"><strong>Attention needed.</strong> Failed URLs are waiting for review or retry.</div>
                                    <div t-else="" class="alert alert-success mb-3"><strong>Everything looks good.</strong> There are no failed URLs in the queue.</div>
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-primary" t-on-click="() => this.openQueue([['state', 'in', ['pending', 'processing']]])"><i class="fa fa-list me-2"/>Open URL Queue</button>
                                        <button class="btn btn-outline-secondary" t-on-click="openSettings"><i class="fa fa-cog me-2"/>IndexNow Settings</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="mb-4">
                        <div class="d-flex align-items-end justify-content-between mb-3"><div><h3 class="mb-1">Websites</h3><span class="text-muted">Health, volume, and quick actions for every website.</span></div></div>
                        <div class="row g-3">
                            <div t-foreach="state.data.websites" t-as="website" t-key="website.id" class="col-12 col-lg-6 col-xxl-4">
                                <article class="card o_indexnow_website_card border-0 shadow-sm h-100">
                                    <div class="card-body p-3 p-lg-4">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                            <div class="overflow-hidden"><h5 class="mb-1 text-truncate"><t t-esc="website.name"/></h5><a class="text-muted text-truncate d-block" t-att-href="website.domain" target="_blank"><t t-esc="website.domain"/> <i class="fa fa-external-link ms-1"/></a></div>
                                            <span t-att-class="'badge rounded-pill text-bg-' + this.healthClass(website.health)"><t t-esc="website.health_label"/></span>
                                        </div>
                                        <div t-if="website.last_error" class="alert alert-danger py-2 small text-truncate" t-att-title="website.last_error"><i class="fa fa-exclamation-circle me-1"/><t t-esc="website.last_error"/></div>
                                        <div class="row g-2 text-center mb-3">
                                            <div class="col-4"><div class="rounded bg-light p-2"><strong class="d-block fs-4"><t t-esc="website.submitted_week"/></strong><small class="text-muted">7-day URLs</small></div></div>
                                            <div class="col-4"><div class="rounded bg-light p-2"><strong class="d-block fs-4 text-warning"><t t-esc="website.pending"/></strong><small class="text-muted">Pending</small></div></div>
                                            <div class="col-4"><div class="rounded bg-light p-2"><strong class="d-block fs-4 text-danger"><t t-esc="website.failed"/></strong><small class="text-muted">Failed</small></div></div>
                                        </div>
                                        <div class="o_indexnow_website_meta small mb-3">
                                            <span class="text-nowrap"><i t-att-class="website.key_verified ? 'fa fa-check-circle text-success me-1' : 'fa fa-times-circle text-muted me-1'"/>Key <t t-esc="website.key_verified ? 'verified' : 'not verified'"/></span>
                                            <span class="text-muted o_indexnow_last_success" t-att-title="'Last success: ' + (website.last_success || 'Never')">Last success: <t t-esc="website.last_success || 'Never'"/></span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button class="btn btn-primary btn-sm" t-if="website.enabled" t-att-disabled="state.busy" t-on-click="() => this.runWebsiteAction(website.id, 'action_indexnow_submit_all_pages')"><i class="fa fa-paper-plane me-1"/>Submit Pages</button>
                                            <button class="btn btn-outline-secondary btn-sm" t-if="website.enabled" t-att-disabled="state.busy" t-on-click="() => this.runWebsiteAction(website.id, 'action_indexnow_process_queue')"><i class="fa fa-play me-1"/>Process Queue</button>
                                            <button class="btn btn-outline-info btn-sm" t-if="website.has_key" t-att-disabled="state.busy" t-on-click="() => this.runWebsiteAction(website.id, 'action_indexnow_verify_key')"><i class="fa fa-key me-1"/>Verify Key</button>
                                            <button class="btn btn-link btn-sm ms-auto" t-on-click="() => this.openHistory(website.id)">History <i class="fa fa-chevron-right ms-1"/></button>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        </div>
                    </section>

                    <section class="row g-3 mb-4">
                        <div class="col-12 col-xl-6">
                            <div class="card border-0 shadow-sm h-100"><div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3"><div><h4 class="mb-0">Queue now</h4><small class="text-muted">URLs waiting to be processed</small></div><button class="btn btn-sm btn-link" t-on-click="() => this.openQueue([])">View all</button></div>
                                <div t-if="!state.data.queue_preview.length" class="card-body text-center text-muted py-5"><i class="fa fa-check-circle fa-2x text-success mb-2 d-block"/>The queue is clear.</div>
                                <div t-else="" class="list-group list-group-flush"><button t-foreach="state.data.queue_preview" t-as="item" t-key="item.id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" t-on-click="() => this.openQueue([['id', '=', item.id]])"><span class="o_indexnow_activity_icon bg-warning-subtle text-warning"><i class="fa fa-clock-o"/></span><span class="overflow-hidden flex-grow-1"><strong class="d-block text-truncate"><t t-esc="item.url"/></strong><small class="text-muted"><t t-esc="item.website"/> · <t t-esc="item.event"/> · attempt <t t-esc="item.attempts"/></small></span><span class="badge text-bg-warning"><t t-esc="item.state"/></span></button></div>
                            </div>
                        </div>
                        <div class="col-12 col-xl-6">
                            <div class="card border-0 shadow-sm h-100"><div class="card-header bg-transparent d-flex justify-content-between align-items-center py-3"><div><h4 class="mb-0">Recent activity</h4><small class="text-muted">Latest IndexNow submission batches</small></div><button class="btn btn-sm btn-link" t-on-click="() => this.openHistory()">View all</button></div>
                                <div t-if="!state.data.recent_activity.length" class="card-body text-center text-muted py-5"><i class="fa fa-inbox fa-2x mb-2 d-block"/>No submission activity yet.</div>
                                <div t-else="" class="list-group list-group-flush"><button t-foreach="state.data.recent_activity" t-as="item" t-key="item.id" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3" t-on-click="() => this.openHistory()"><span t-att-class="'o_indexnow_activity_icon bg-' + this.resultClass(item.result) + '-subtle text-' + this.resultClass(item.result)"><i t-att-class="item.result === 'failed' ? 'fa fa-times' : 'fa fa-check'"/></span><span class="flex-grow-1"><strong><t t-esc="item.url_count"/> URLs · <t t-esc="item.website"/></strong><small class="text-muted d-block"><t t-esc="item.trigger"/> · <t t-esc="item.submitted_on"/></small></span><span t-att-class="'badge text-bg-' + this.resultClass(item.result)"><t t-esc="item.result"/></span></button></div>
                            </div>
                        </div>
                    </section>
                </t>
            </div>
        </div>
    </t>
</templates>
