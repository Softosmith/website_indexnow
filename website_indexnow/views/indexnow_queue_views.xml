<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="indexnow_queue_list" model="ir.ui.view">
        <field name="name">website.indexnow.queue.list</field>
        <field name="model">website.indexnow.queue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-success="state in ('submitted', 'accepted')">
                <header>
                    <button name="action_process_now" type="object" string="Process Now" class="btn-primary" groups="website_indexnow.group_indexnow_manager"/>
                    <button name="action_retry" type="object" string="Retry Failed" groups="website_indexnow.group_indexnow_manager"/>
                    <button name="action_cancel" type="object" string="Cancel Selected" groups="website_indexnow.group_indexnow_manager"/>
                </header>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="url"/>
                <field name="event"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accepted'"
                       decoration-info="state == 'submitted'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'pending'"
                       decoration-primary="state == 'processing'"
                       decoration-muted="state in ('cancelled', 'removed')"/>
                <field name="attempts"/>
                <field name="next_attempt"/>
                <field name="queued_on"/>
                <field name="last_http_status" optional="show"/>
                <field name="submission_id" optional="hide"/>
                <button name="action_open_url" type="object" icon="fa-external-link" title="Open URL"/>
                <button name="action_open_page" type="object" icon="fa-file-o" title="Open Page" invisible="not page_id"/>
            </list>
        </field>
    </record>
    <record id="indexnow_queue_form" model="ir.ui.view">
        <field name="name">website.indexnow.queue.form</field><field name="model">website.indexnow.queue</field>
        <field name="arch" type="xml">
            <form string="IndexNow Queue Entry"><header>
            <button name="action_process_now" type="object" string="Process Now" class="btn-primary" invisible="state != 'pending'"/>
            <button name="action_retry" type="object" string="Retry" invisible="state != 'failed'"/>
            <field name="state" widget="statusbar"/>
        </header><sheet><group><group><field name="website_id"/><field name="page_id"/><field name="url"/><field name="event"/></group><group><field name="attempts"/><field name="next_attempt"/><field name="queued_on"/><field name="submitted_on"/><field name="last_http_status"/><field name="submission_id"/></group></group><field name="last_error"/></sheet></form></field>
    </record>
    <record id="indexnow_queue_search" model="ir.ui.view">
        <field name="name">website.indexnow.queue.search</field><field name="model">website.indexnow.queue</field>
        <field name="arch" type="xml">
            <search><field name="url"/><field name="website_id"/><field name="event"/><filter name="pending" string="Pending" domain="[('state', 'in', ('pending', 'processing'))]"/><filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/><filter name="submitted" string="Submitted" domain="[('state', 'in', ('submitted', 'accepted'))]"/><group name="groupby"><filter name="group_website" string="Website" context="{'group_by': 'website_id'}"/><filter name="group_event" string="Event" context="{'group_by': 'event'}"/><filter name="group_state" string="State" context="{'group_by': 'state'}"/></group></search></field>
    </record>
    <record id="action_indexnow_queue" model="ir.actions.act_window">
        <field name="name">URL Queue</field><field name="res_model">website.indexnow.queue</field><field name="view_mode">list,form</field><field name="search_view_id" ref="indexnow_queue_search"/>
    </record>
</odoo>
